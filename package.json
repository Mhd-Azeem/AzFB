{
  "name": "az-leads-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "worker:check": "tsc -p tsconfig.worker.json",
    "db:local": "wrangler d1 migrations apply az-leads-local --local",
    "deploy": "npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.0",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/node": "^24.0.0"
  }
}
